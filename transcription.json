            }
          ],
          "notes": []
        },
        {
          "side": "left",
          "units": [
            {
              "id": "004l01",
              "role": "body",
              "text": "○癸酉九月二十七日醫官崔聖任"
            },
            {
              "id": "004l02",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "004l03",
              "role": "body",
              "text": "○癸酉九月二十九日醫官鄭斗俊"
            },
            {
              "id": "004l04",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "004l05",
              "role": "body",
              "text": "○癸酉十月初一日"
            },
            {
              "id": "004l06",
              "role": "body",
              "text": "安産室藏胎衣吉方逐月改易故今日卯時産畜改貼於柱壁上加莫金"
            },
            {
              "id": "004l07",
              "role": "body",
              "text": "馬韉移掛於甲方馬皮亦爲移設東首西尾此事與次知內官眼同"
            },
            {
              "id": "004l08",
              "role": "body",
              "text": "排置後卽爲"
            },
            {
              "id": "004l09",
              "role": "body",
              "text": "啓達　自淑媛房饋酒"
            },
            {
              "id": "004l10",
              "role": "body",
              "text": "○癸酉十月初二日醫官崔聖任"
            },
            {
              "id": "004l11",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "004l12",
              "role": "body",
              "text": "○癸酉十月初四日醫官鄭斗俊"
            },
            {
              "id": "004l13",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "004l14",
              "role": "body",
              "text": "○癸酉十月初六日三更量"
            }
          ],
          "notes": [
            "第6欄起首欄上可見小墨點，暫未判作正文。"
          ]
        }
      ]
    },
    {
      "image": 5,
      "label": "005",
      "id": "20170620051726062",
      "sha256": "5981894f246a77fc6d6c2d8ffc2413f8b90b20ae8e7fdd9d9d1d7edbcc27fa0b",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051726062.xml",
      "scan_width": 3206,
      "scan_height": 2495,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "005r01",
              "role": "body",
              "text": "傳于政院崔淑媛有腹痛之氣護産醫官崔聖任鄭斗俊醫女翠葉仁"
            },
            {
              "id": "005r02",
              "role": "body",
              "text": "香等留門招入亦敎是乎等以四更量並爲一齊入來而護産書員"
            },
            {
              "id": "005r03",
              "role": "body",
              "text": "尹以俊申永萬亦及於留門時入來今日直宿爲始次知內官張厚載醫"
            },
            {
              "id": "005r04",
              "role": "body",
              "text": "官崔聖任鄭斗俊奏時官周後昌書員尹以俊申永萬別監李時"
            },
            {
              "id": "005r05",
              "role": "body",
              "text": "成兪多典司僕諸員金重信李士龍李後蕃奏時使令金義俊"
            },
            {
              "id": "005r06",
              "role": "body",
              "text": "等自　內司倍饋醫女翠葉仁香自　內供饋而饋酒事則以七日內"
            },
            {
              "id": "005r07",
              "role": "body",
              "text": "拘忌停之"
            },
            {
              "id": "005r08",
              "role": "body",
              "text": "○同日四更量次知內官張厚載醫官崔聖任鄭斗俊等書"
            },
            {
              "id": "005r09",
              "role": "body",
              "text": "啓崔淑媛症候卽伏聞醫女所傳之言則夜來連有腹痛之候卽今有加云姑"
            },
            {
              "id": "005r10",
              "role": "body",
              "text": "未知産候或美痛與否而佛手散則預服數三貼極爲宜當故此藥加益母"
            },
            {
              "id": "005r11",
              "role": "body",
              "text": "草二錢方爲煎入之意詮次云々"
            },
            {
              "id": "005r12",
              "role": "body",
              "text": "○同日未明書"
            },
            {
              "id": "005r13",
              "role": "body",
              "text": "啓崔淑媛症候卽者醫女等言內腹痛之候漸至頻數微有白露氣似綿濕"
            },
            {
              "id": "005r14",
              "role": "body",
              "text": "云此皆例有之事而扶元保血之法不可不兼施故加益母草佛手散及"
            }
          ],
          "notes": [
            "人名『仁香』為欄1、2越欄合讀，與前頁暫讀『仁德』不同，需回圖。欄5『兪多典』『重』『蕃』候讀。欄10『美』、欄11『詮』、欄13『綿濕』候讀。『々』代表原稿小重文標記，形體尚待再辨。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "005l01",
              "role": "body",
              "text": "五錢重參茶亦爲相間用之之意詮次云々"
            },
            {
              "id": "005l02",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "005l03",
              "role": "body",
              "text": "啓崔淑媛當日辰初一刻誕生男阿只氏之意詮次云々"
            },
            {
              "id": "005l04",
              "role": "body",
              "text": "○同日卽爲懸草於差備門楣上"
            },
            {
              "id": "005l05",
              "role": "body",
              "text": "蜜朱盛小鍾子醫女翠葉入黃連甘草湯日氣頗寒故不入"
            },
            {
              "id": "005l06",
              "role": "body",
              "text": "○同日辰時書"
            },
            {
              "id": "005l07",
              "role": "body",
              "text": "啓崔淑媛無事解娩之後醫女言內胞衣時未卽下云此雖例候而"
            },
            {
              "id": "005l08",
              "role": "body",
              "text": "芎歸湯加紅花桃仁冬葵子榆白皮各一錢硝石二錢令方煎入之意"
            },
            {
              "id": "005l09",
              "role": "body",
              "text": "詮次云々"
            },
            {
              "id": "005l10",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "005l11",
              "role": "body",
              "text": "啓崔淑媛醫女言內卽今胞衣無事順下云不勝喜幸之意　詮次"
            },
            {
              "id": "005l12",
              "role": "body",
              "text": "云々"
            },
            {
              "id": "005l13",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "005l14",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內卽今別無所患而和飯羹湯分娩後二巡"
            }
          ],
          "notes": [
            "欄3『只』字形與《同冊》其他『阿只氏』擬對照，但不得逕作『呂』；欄5『蜜朱』『鍾』候讀。欄8『令』待與『今』比較。末欄圭形頭部的『羹』為候讀。"
          ]
        }
      ]
    },
    {
      "image": 6,
      "label": "006",
      "id": "20170620051744173",
      "sha256": "0af383169743424b21d252767e86af44d0260461dbab50d63cc8bcea80945e8d",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051744173.xml",
      "scan_width": 3207,
      "scan_height": 2492,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "006r01",
              "role": "body",
              "text": "胞衣旣下後二巡無事連喫新生　阿只氏亦爲平安暫爲睡覺之後顒"
            },
            {
              "id": "006r02",
              "role": "body",
              "text": "有轉眄吃乳之意云故乳汁少許亦令以匙呷下之意詮次云々"
            },
            {
              "id": "006r03",
              "role": "body",
              "text": "○同日午時書"
            },
            {
              "id": "006r04",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內和飯羹湯自分娩以後連喫八巡無事順下　阿"
            },
            {
              "id": "006r05",
              "role": "body",
              "text": "只氏再巡乳汁以匙呷下開眼轉睛氣息平穩云此意詮次云々"
            },
            {
              "id": "006r06",
              "role": "body",
              "text": "○同日申時書"
            },
            {
              "id": "006r07",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內和飯羹湯連續進喫通計至十一巡而一樣無"
            },
            {
              "id": "006r08",
              "role": "body",
              "text": "事　阿只氏眠睡極穩少放胎糞以匙呷乳頗似甘吃氣息亦爲平"
            },
            {
              "id": "006r09",
              "role": "body",
              "text": "安之意詮次云々"
            },
            {
              "id": "006r10",
              "role": "body",
              "text": "○癸酉十月初七日卯時書"
            },
            {
              "id": "006r11",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內夜間眠睡平穩如常和飯羹湯連喫四巡　阿"
            },
            {
              "id": "006r12",
              "role": "body",
              "text": "只氏吃乳極善氣息一樣平穩云不勝喜幸之意詮次云々"
            },
            {
              "id": "006r13",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "006r14",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內朝來一樣平穩連喫和飯羹湯三巡　阿"
            }
          ],
          "notes": [
            "欄1『顒』、欄2『眄』、各欄『羹』、欄8『甘』為候讀。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "006l01",
              "role": "body",
              "text": "只氏吃乳極善才放色黃胎糞小水亦爲通下云此意詮次云々"
            },
            {
              "id": "006l02",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "006l03",
              "role": "body",
              "text": "啓崔淑媛分娩後第三日洗浴吉時今月初八日午未間丁時　阿只氏"
            },
            {
              "id": "006l04",
              "role": "body",
              "text": "洗浴吉時同日同時洗胎吉時同日未時捲草發吉時今月十二"
            },
            {
              "id": "006l05",
              "role": "body",
              "text": "日卯時是如日官推擇來言當爲擧行洗胎水宜取月德甲方"
            },
            {
              "id": "006l06",
              "role": "body",
              "text": "水用之而第伏念寒月洗浴之節必或有感傷之慮只用手巾略"
            },
            {
              "id": "006l07",
              "role": "body",
              "text": "爲蘸拭萬分宜當之意并以詮次云々"
            },
            {
              "id": "006l08",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "006l09",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內一樣平穩和飯羹湯連喫七巡　阿只氏連續吃乳"
            },
            {
              "id": "006l10",
              "role": "body",
              "text": "氣息亦爲平安云不勝喜幸之意詮次云々"
            },
            {
              "id": "006l11",
              "role": "body",
              "text": "○癸酉十月初八日卯時書"
            },
            {
              "id": "006l12",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言 內夜間眠睡極爲安穩和飯羹湯連喫十巡　阿只氏"
            },
            {
              "id": "006l13",
              "role": "body",
              "text": "吃乳五巡氣息亦爲平安之意詮次云々"
            },
            {
              "id": "006l14",
              "role": "body",
              "text": "○同日"
            }
          ],
          "notes": [
            "欄4『捲草發』、欄7『蘸』候讀。欄12『言內』字間墨暈，保留初錄但空格待清理。"
          ]
        }
      ]
    },
    {
      "image": 7,
      "label": "007",
      "id": "20170620051802784",
      "sha256": "6e9f0fec1e694f8c0ffcf4b95d3cdfb0b7b04fe3ed827f223953a23975056d4a",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051802784.xml",
      "scan_width": 3208,
      "scan_height": 2497,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "007r01",
              "role": "body",
              "text": "啓崔淑媛房洗浴所用艾湯入盛二所羅陳艾一偏手巾次白苧布白正布"
            },
            {
              "id": "007r02",
              "role": "body",
              "text": "各三尺白馬尾篩一部　阿只氏洗浴次桃梅李三根虎頭煎湯和猪"
            },
            {
              "id": "007r03",
              "role": "body",
              "text": "膽一部入盛鍮東海手巾次白絹三尺洗胎所用陶豆毛蓋具一坐瓢"
            },
            {
              "id": "007r04",
              "role": "body",
              "text": "子一箇酒一瓶藍紬一尺油紙一張並醫女兩人入之"
            },
            {
              "id": "007r05",
              "role": "body",
              "text": "○同日未時"
            },
            {
              "id": "007r06",
              "role": "body",
              "text": "洗胎時月德方水洗百度後以酒更洗入內缸中銅錢一箇先入缸底油"
            },
            {
              "id": "007r07",
              "role": "body",
              "text": "紙青藍覆缸口自　內封標出送內官醫官同坐以甘糨封缸口入外缸"
            },
            {
              "id": "007r08",
              "role": "body",
              "text": "中以紙及白綿爲隔封外缸後次知內官醫官着署懸紅牌前面書"
            },
            {
              "id": "007r09",
              "role": "body",
              "text": "康熙三十二年十月初六日　崔淑媛房解産男阿只氏胎後面書次"
            },
            {
              "id": "007r10",
              "role": "body",
              "text": "知內官醫官入於陶豆毛內薄以常毛氈使醫女入還安於月空方"
            },
            {
              "id": "007r11",
              "role": "body",
              "text": "自　內擇定胎峯藏之"
            },
            {
              "id": "007r12",
              "role": "body",
              "text": "○同日"
            },
            {
              "id": "007r13",
              "role": "body",
              "text": "阿只氏付紐次朱砂石雄黃各一塊醫女仁香入之"
            },
            {
              "id": "007r14",
              "role": "body",
              "text": "○同日"
            }
          ],
          "notes": [
            "欄1『所羅』、『偏』、欄3『鍮東海』、欄6『百度』、欄7『青藍』『糨』、欄10『薄』、欄13『紐』與『石』均候回圖。『康熙三十二年』為原稿自記，對應1693年。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "007l01",
              "role": "body",
              "text": "崔淑媛氣候醫女言內洗浴之後一樣無事阿只氏洗浴之後吃乳極"
            },
            {
              "id": "007l02",
              "role": "body",
              "text": "善氣息亦爲平安云此意詮次云々"
            },
            {
              "id": "007l03",
              "role": "body",
              "text": "○癸酉十月初九日卯時書"
            },
            {
              "id": "007l04",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內夜間眠睡如常連喫和飯羹湯二巡阿只氏"
            },
            {
              "id": "007l05",
              "role": "body",
              "text": "吃乳五巡便溺順利氣息一樣平安云此意詮次云々"
            },
            {
              "id": "007l06",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "007l07",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內自朝以來和飯羹湯連喫二巡一樣無事阿只"
            },
            {
              "id": "007l08",
              "role": "body",
              "text": "氏吃乳二巡便溺亦爲平順云此意詮次云々"
            },
            {
              "id": "007l09",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "007l10",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內未時書　啓後白飯及生雉熟紅蛤湯略爲進"
            },
            {
              "id": "007l11",
              "role": "body",
              "text": "喫一樣無事阿只氏入睡安穩氣息如前云此意詮次云々"
            },
            {
              "id": "007l12",
              "role": "body",
              "text": "○癸酉十月初十日書"
            },
            {
              "id": "007l13",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內夜間眠睡安穩和飯羹湯連喫三巡阿只氏吃乳"
            },
            {
              "id": "007l14",
              "role": "body",
              "text": "極善放溺三巡一樣無事云此意詮次云々"
            }
          ],
          "notes": [
            "第10欄『紅蛤』字形待回圖。"
          ]
        }
      ]
    },
    {
      "image": 8,
      "label": "008",
      "id": "20170620051821270",
      "sha256": "b86abf5d5df2639083ff32457ce4b2c91f585b762f888934c221209d5b376630",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051821270.xml",
      "scan_width": 3208,
      "scan_height": 2497,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "008r01",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "008r02",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內朝後連喫和飯羹湯二巡阿只氏吃乳一巡眠睡"
            },
            {
              "id": "008r03",
              "role": "body",
              "text": "一樣平穩云此意詮次云々"
            },
            {
              "id": "008r04",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "008r05",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內未時書　啓後又喫和飯羹湯一巡一樣無事"
            },
            {
              "id": "008r06",
              "role": "body",
              "text": "阿只氏吃乳與便溺亦極平順云此意詮次云々"
            },
            {
              "id": "008r07",
              "role": "body",
              "text": "○癸酉十月十一日書"
            },
            {
              "id": "008r08",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內夜間眠睡安穩和飯羹湯連喫三巡阿只氏吃"
            },
            {
              "id": "008r09",
              "role": "body",
              "text": "乳極善便溺一樣調順云此意詮次云々"
            },
            {
              "id": "008r10",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "008r11",
              "role": "body",
              "text": "啓崔淑媛氣候醫娩以後少無症患極爲喜幸矣今始伏聞醫女所傳"
            },
            {
              "id": "008r12",
              "role": "body",
              "text": "之言則大便乾秘已過累日尚不通下至有作痛頻苦之時云此乃産"
            },
            {
              "id": "008r13",
              "role": "body",
              "text": "後例有之事而苦口湯劑恐有妨於食治姑用三仁粥以爲潤燥"
            },
            {
              "id": "008r14",
              "role": "body",
              "text": "導滯之地宜此意詮次云々"
            }
          ],
          "notes": [
            "第11欄『醫娩』雖不順仍先保留形讀，待考前一字是否『解』。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "008l01",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "008l02",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內未時書　啓後喫和飯羹湯二巡三仁粥"
            },
            {
              "id": "008l03",
              "role": "body",
              "text": "五合許一巡姑未得通便而阿只氏吃乳二巡便溺極順氣息一樣"
            },
            {
              "id": "008l04",
              "role": "body",
              "text": "平安云此意詮次云々"
            },
            {
              "id": "008l05",
              "role": "body",
              "text": "○癸酉十月十二日書"
            },
            {
              "id": "008l06",
              "role": "body",
              "text": "啓崔淑媛氣候醫女言內夜間連喫和飯羹湯三巡時未通便而別"
            },
            {
              "id": "008l07",
              "role": "body",
              "text": "無大段痛候阿只氏眠睡及二便極爲安穩平順云此意詮次云々"
            },
            {
              "id": "008l08",
              "role": "body",
              "text": "○同日卯時捲草祭時先鋪地衣次置馬木於左右而加排大板子四葉其"
            },
            {
              "id": "008l09",
              "role": "body",
              "text": "上排命米十斗武布帒十包列置而右置命絲十斤左置命紬十疋"
            },
            {
              "id": "008l10",
              "role": "body",
              "text": "中置命銀八十兩設香爐香盒左右燭臺安肉燭鋪排席於階下護産"
            },
            {
              "id": "008l11",
              "role": "body",
              "text": "醫官就位再拜仍詣懸草前下人一人捧函從之醫官親自捲草置函"
            },
            {
              "id": "008l12",
              "role": "body",
              "text": "中下人持函安床上醫官詣香案前焚香下階就位行再拜禮後次知內官"
            },
            {
              "id": "008l13",
              "role": "body",
              "text": "醫官同坐捲草入盛苧布帒以小紅袱裹封々外書醫官某着署入"
            },
            {
              "id": "008l14",
              "role": "body",
              "text": "函中函外以紅染條兩結封々外書次知內官又着署懸紅木牌一面書"
            }
          ],
          "notes": [
            "『帒』兩處保留候讀，勿逕常體化。第9欄『武』、第10欄『肉』、第13欄『袱』、第14欄『條』待覆核。"
          ]
        }
      ]
    },
    {
      "image": 9,
      "label": "009",
      "id": "20170620051846901",
      "sha256": "9a001ace1d34ef99460e13937cb810425667fa1f5b2b1eafb01f7aa1c45defac",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051846901.xml",
      "scan_width": 3207,
      "scan_height": 2495,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "009r01",
              "role": "body",
              "text": "康熙三十二年十月十二日　崔淑媛解産男阿只氏捲草以次奴紅染三甲"
            },
            {
              "id": "009r02",
              "role": "body",
              "text": "所負函又以大紅袱覆函騎馬以出內資寺主簿朴尚斌部將二員領去"
            },
            {
              "id": "009r03",
              "role": "body",
              "text": "引路軍士二名捧柜軍士六名出去內資寺而捲草祭物目入於　內間"
            },
            {
              "id": "009r04",
              "role": "body",
              "text": "捲草官　御醫鄭斗俊別饋酒藍花方紬一疋內官醫官以下員役並饋酒"
            },
            {
              "id": "009r05",
              "role": "body",
              "text": "內資寺主簿朴尚斌襲子一部欠等二員扇子各三把兵曹書吏內資寺"
            },
            {
              "id": "009r06",
              "role": "body",
              "text": "部將廳衛將所書員各扇子二把使令一名書者一名軍士八名各足巾次"
            },
            {
              "id": "009r07",
              "role": "body",
              "text": "一端或負函杻奴官木一疋給之內資寺官員以下饋酒"
            },
            {
              "id": "009r08",
              "role": "body",
              "text": "○同日書"
            },
            {
              "id": "009r09",
              "role": "body",
              "text": "啓崔淑媛分娩後今日乃第七日而別無大段所患阿只氏氣候極爲平安"
            },
            {
              "id": "009r10",
              "role": "body",
              "text": "臣等依前例退而臣聖任臣斗俊姑爲輪回入直於藥房之意詮次云々"
            },
            {
              "id": "009r11",
              "role": "body",
              "text": "大殿賞格次知內官一員醫官二員各大豹皮一令白鼎紬一疋奏時官一員"
            },
            {
              "id": "009r12",
              "role": "body",
              "text": "差備內官一員各白木二疋書員二人別監二人飯監一人各官木一疋白木"
            },
            {
              "id": "009r13",
              "role": "body",
              "text": "一疋醫女二名各白鼎紬一疋官木一疋白木四疋司僕諸員三名各色掌"
            },
            {
              "id": "009r14",
              "role": "body",
              "text": "一名城上一名水工一名奏時使令一名各五升布二疋"
            }
          ],
          "notes": [
            "欄1『三甲』、欄2『斌』、欄3『柜』、欄5『襲』與『欠等』、欄7『或』與『杻』、欄11『鼎』均須回圖。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "009l01",
              "role": "body",
              "text": "中宮殿賞格次知內官一員醫官二員各白吐紬一疋白鼎紬一疋　差備內官一員"
            },
            {
              "id": "009l02",
              "role": "body",
              "text": "奏時官一員各白木二疋書員二人別監二人飯監一人各官木一疋白木一疋"
            },
            {
              "id": "009l03",
              "role": "body",
              "text": "醫女二名各官木一疋白木三疋司僕諸員三名各色掌一名城上一名水工"
            },
            {
              "id": "009l04",
              "role": "body",
              "text": "一名奏時使令一名各五升布二疋"
            },
            {
              "id": "009l05",
              "role": "body",
              "text": "崔淑媛房賞格次知內官一員醫官二員各白方絲紬一疋白吐紬一疋白鼎"
            },
            {
              "id": "009l06",
              "role": "body",
              "text": "紬一疋差備內官一員奏時官一員各白鼎紬一疋官木一疋白木一疋書員"
            },
            {
              "id": "009l07",
              "role": "body",
              "text": "二人別監二人飯監一人各白木一疋官木一疋五升布一疋醫女二名各"
            },
            {
              "id": "009l08",
              "role": "body",
              "text": "白鼎紬二疋白木三疋司僕諸員三名各色掌一名城上一名水工一名"
            },
            {
              "id": "009l09",
              "role": "body",
              "text": "奏時使令一名各官木一疋五升布二疋"
            },
            {
              "id": "009l10",
              "role": "body",
              "text": "○癸酉十月十六日"
            },
            {
              "id": "009l11",
              "role": "body",
              "text": "大殿次知內官張厚載醫官崔聖任鄭斗俊各內廐馬一匹　賜給"
            }
          ],
          "notes": [
            "末三空欄實見；欄1及5『吐』、『鼎』屬織物名候讀，欄5『方絲紬』待覆核。欄11『廐』保存候讀。全文最後日期癸酉十月十六日。"
          ]
        }
      ]
    },
