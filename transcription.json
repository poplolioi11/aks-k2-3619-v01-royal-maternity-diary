    {
      "image": 2,
      "label": "002",
      "id": "20170620051630447",
      "sha256": "437afa2fe5993d7d288b5110101b2b2105f06e1a6724427b7ae3951c1561e826",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051630447.xml",
      "scan_width": 3208,
      "scan_height": 2490,
      "surfaces": [
        {
          "side": "right",
          "units": [],
          "notes": [
            "有欄框和紙痕，未見正文。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "002l01",
              "role": "body",
              "text": "○癸酉九月初三日"
            },
            {
              "id": "002l02",
              "role": "body",
              "text": "差備招掌務官"
            },
            {
              "id": "002l03",
              "role": "body",
              "text": "傳曰崔淑媛來十月當是産月産室諸事照例擧行事言于醫官"
            },
            {
              "id": "002l04",
              "role": "body",
              "text": "○癸酉九月初四日"
            },
            {
              "id": "002l05",
              "role": "body",
              "text": "崔淑媛護産醫官望崔聖任鄭惟覺李弘章金汝器柳諶鄭斗"
            },
            {
              "id": "002l06",
              "role": "body",
              "text": "俊金慶華韓俊興李命常玄萬運全世弘掌務官崔萬尚邊永清"
            },
            {
              "id": "002l07",
              "role": "body",
              "text": "酒房官全壽峯酒房官尹聖輔監捧官玄瑞夏掌務官全國賁康汝泰"
            },
            {
              "id": "002l08",
              "role": "body",
              "text": "李道元張聖維張天翊趙興瑞"
            },
            {
              "id": "002l09",
              "role": "body",
              "text": "落點崔聖任鄭斗俊"
            },
            {
              "id": "002l10",
              "role": "body",
              "text": "○同日醫官崔聖任入"
            },
            {
              "id": "002l11",
              "role": "body",
              "text": "侍時　崔淑媛産室諸具當爲擧行而醫官依前例間一日輪回問　安事"
            },
            {
              "id": "002l12",
              "role": "body",
              "text": "啓稟蒙　允醫官等直宿事臨時分付之意自　　上下敎"
            },
            {
              "id": "002l13",
              "role": "body",
              "text": "○同日院"
            },
            {
              "id": "002l14",
              "role": "body",
              "text": "啓目崔淑媛産室時湯藥書員尹以俊申永萬醫女翠葉仁德差下何"
            }
          ],
          "notes": [
            "前3欄經朱印疊壓，欄2前2字待二讀。",
            "欄5『諶』、欄6『清』、欄7『賁』與末欄『仁德』待二讀；人名字形勿用目錄常形替代。",
            "左葉朱印待辨，未混入正文。"
          ]
        }
      ]
    },
    {
      "image": 3,
      "label": "003",
      "id": "20170620051648434",
      "sha256": "ec9a7a8b32b9a38ee7e8b47c9ece25c5cfaf412e50bd287d15b484b066c343ca",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620051648434.xml",
      "scan_width": 3206,
      "scan_height": 2493,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "003r01",
              "role": "body",
              "text": "如　啓依　允又"
            },
            {
              "id": "003r02",
              "role": "body",
              "text": "啓目崔淑媛産室排設時所用白馬皮一令馬韉一部羊毛氈三浮六張付"
            },
            {
              "id": "003r03",
              "role": "body",
              "text": "油芚二浮四張付油芚三浮捲草時所用命白米一百斗命正銀八"
            },
            {
              "id": "003r04",
              "role": "body",
              "text": "十兩命黃絲十斤命紬十疋令該曹急速進排爲白乎矣此外應入乙"
            },
            {
              "id": "003r05",
              "role": "body",
              "text": "雜物乙良依前例提調直捧甘結取用何如　啓依　允"
            },
            {
              "id": "003r06",
              "role": "body",
              "text": "○癸酉九月初五日醫官崔聖任鄭斗俊"
            },
            {
              "id": "003r07",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "003r08",
              "role": "body",
              "text": "○癸酉九月初七日醫官崔聖任"
            },
            {
              "id": "003r09",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "003r10",
              "role": "body",
              "text": "○癸酉九月初九日醫官鄭斗俊"
            },
            {
              "id": "003r11",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "003r12",
              "role": "body",
              "text": "○癸酉九月十一日醫官崔聖任"
            },
            {
              "id": "003r13",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "003r14",
              "role": "body",
              "text": "○同日醫官崔聖任鄭斗俊詣　差備"
            }
          ],
          "notes": [
            "欄2『韉』與『氈』待形體覆核，欄3兩『芚』待覆核。",
            "欄4末字可能為夾注或筆畫受欄邊干擾，暫讀『乙』。",
            "各欄『斗俊』之斗不用量詞義另行改字。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "003l01",
              "role": "body",
              "text": "啓曰明日　崔淑媛産室排設之意敢　啓　答曰知道"
            },
            {
              "id": "003l02",
              "role": "body",
              "text": "○癸酉九月十二日醫官崔聖任鄭斗俊"
            },
            {
              "id": "003l03",
              "role": "body",
              "text": "崔淑媛房問　安答曰無事"
            },
            {
              "id": "003l04",
              "role": "body",
              "text": "○同日巳時"
            },
            {
              "id": "003l05",
              "role": "body",
              "text": "昌慶宮養華堂東精一齋産室排設時次知內官張厚載醫官崔聖任"
            },
            {
              "id": "003l06",
              "role": "body",
              "text": "鄭斗俊奏時官周後昌迴鑾官朴振門擇日官李貴賢書員尹"
            },
            {
              "id": "003l07",
              "role": "body",
              "text": "以俊申永萬入室方位付二十四字而柱壁上先貼産畜次貼催生符次"
            },
            {
              "id": "003l08",
              "role": "body",
              "text": "貼借地法安産室吉方藏胎衣吉方釘加莫金懸馬韉後先鋪黃草"
            },
            {
              "id": "003l09",
              "role": "body",
              "text": "次鋪空石次鋪草席次鋪羊毛氈次鋪油芚次鋪白馬皮白馬皮頭下"
            },
            {
              "id": "003l10",
              "role": "body",
              "text": "鋪生苧頭上鋪鼬鼠皮次鋪剪邊空石一立後醫官鄭斗俊讀借地法三度"
            },
            {
              "id": "003l11",
              "role": "body",
              "text": "後出仍爲懸鈴産室門外懸草屨排釘三寸釘三箇而出"
            },
            {
              "id": "003l12",
              "role": "body",
              "text": "排設後次知內官一員　差備內官一員護産醫官二員迴鑾官一員擇日"
            },
            {
              "id": "003l13",
              "role": "body",
              "text": "官一員奏時官一員別監二人書員二人醫女二人司僕諸員三名奏時"
            },
            {
              "id": "003l14",
              "role": "body",
              "text": "使令一名自　淑媛房饋酒"
            }
          ],
          "notes": [
            "『迴鑾』兩處為候讀，欄6可見首字辶旁，末字形近鐵；不依古代官職猜補。『産畜』、『加莫金』和『周後昌』亦待回圖。"
          ]
        }
      ]
    },
